# =============================================================================
# Coda 统一生产环境配置 (.env)
# 统一适用于：./start.sh (Docker Compose) / Systemd (coda-server & coda-relay-cn) / 二进制直接运行
# 部署时复制为 `.env` 或 `/etc/coda/.env` (chmod 600) 并修改密钥即可
# =============================================================================

# 1. 部署模式：
#   coordinator : 主控制面 + PostgreSQL + Web 控制台 (:8080) + 免备案裸 TCP 中继 (:24443)
#   relay-cn    : 仅启动国内免备案无状态裸 TCP 中继 (:24443，零数据库/零 HTTP)
DEPLOY_MODE=coordinator

# 2. 预构建公网容器镜像（默认直接使用 GitHub Container Registry 预编译多架构镜像）
CODA_IMAGE=ghcr.io/annihilater/coda:latest

# 3. 对外映射端口与公网入口（已绑定 Cloudflare Tunnel HTTPS 域名 https://codahub.dev）
CODA_HTTP_PORT=8080
CODA_RAW_TCP_PORT=24443
CODA_PUBLIC_URL=https://codahub.dev
CODA_HTTP_BIND=0.0.0.0:8080
CODA_RAW_TCP_BIND=0.0.0.0:24443
CODA_REGION_LABEL=CN-BGP-NoICP

# 3b. 是否开放自助注册（true=官网允许任何用户免邀请码自由注册；false=仅首号免邀，后续需管理员邀请码）
CODA_OPEN_REGISTRATION=true

# 3c. 下载中心版本号、仓库来源与 iOS Beta TestFlight/OTA 安装地址（可选）
CODA_GITHUB_REPO=Annihilater/coda
# CODA_RELEASE_VERSION=v0.3.3
# CODA_IOS_BETA_URL=https://testflight.apple.com/join/YOUR_CODE
# CODA_RAW_TCP_PUBLIC_ENDPOINT=cn-relay.codahub.dev:24443

# 4. 控制面与国内免备案中继共享的 HMAC 密钥（必填，主控与所有中继必须一致）
# 生成命令: openssl rand -hex 32
CODA_RELAY_SECRET=coda_shared_hmac_relay_secret_change_me_2026

# 5. PostgreSQL 18 数据库密码（Docker 模式下自动拼接内部连接串；relay-cn 模式自动忽略）
POSTGRES_PASSWORD=coda_prod_change_me_2026

# 6. 可选：裸机安装或连接外部 PostgreSQL 时覆盖数据库连接串
# DATABASE_URL=postgres://coda:coda_prod_change_me_2026@127.0.0.1:5432/coda_prod

# 7. 可选：国内服务器无法直连 github.com 下载离线镜像包时，可设置加速前缀（例如 https://ghfast.top/）
# GITHUB_PROXY=
