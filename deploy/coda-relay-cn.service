# Systemd Unit for Domestic Cloud (Aliyun / Tencent Cloud) No-ICP Raw TCP Relay Node
#
# Recommended Linux Kernel BBR & Low-Latency TCP Tuning (/etc/sysctl.d/99-coda-relay.conf):
#   net.core.default_qdisc = fq
#   net.ipv4.tcp_congestion_control = bbr
#   net.ipv4.tcp_fastopen = 3
#   net.ipv4.tcp_notsent_lowat = 16384
#
# Notice: This service binds ONLY port 24443 with length-prefixed binary ChaCha20-Poly1305 frames.
# Zero HTTP headers, zero TLS SNI, and ports 80/443 remain completely closed — 100% exempt from ICP domain filing.

[Unit]
Description=Coda Stateless Domestic Cloud No-ICP Relay Node (:24443)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="CODA_RELAY_SECRET=replace-with-shared-hmac-secret"
ExecStart=/usr/local/bin/coda-server --relay-only --raw-tcp-bind 0.0.0.0:24443 --region-label CN-BGP-NoICP
Restart=always
RestartSec=2
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
