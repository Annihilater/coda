# =============================================================================
# Coda Production Configuration (.env)
# Copy this file to `.env` before running `docker compose up -d`
# =============================================================================

# PostgreSQL 18 Database Password
POSTGRES_PASSWORD=coda_prod_change_me_2026

# Shared HMAC Secret between Coordinator and Stateless Domestic Relay Nodes
# (Generate with: openssl rand -hex 32)
CODA_RELAY_SECRET=coda_shared_hmac_relay_secret_change_me_2026

# Public URL of your Coordinator (Domain with CDN or Raw IP:8080)
CODA_PUBLIC_URL=http://127.0.0.1:8080
